<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicalOptimizer\LogicalOptimizer.csproj" />
    <!-- Knowledge-compilation layer (d-DNNF). The facade does not reference it, but the
         cross-library comparison suite (comparison-suite verb) measures d-DNNF compile /
         model-count alongside BDD, so the bench project references it directly. -->
    <ProjectReference Include="..\LogicalOptimizer.Dnnf\LogicalOptimizer.Dnnf.csproj" />
  </ItemGroup>

</Project>
