<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Deprecated forwarding shell (doc/decisions/package-consolidation-v4.md): before
         v4.0 this was the "everything" meta-package; since v4.0 the single LogicalOptimizer
         package IS everything, so this ID only forwards to it. Packed from the hand-written
         .nuspec, same as the shells under forwarding/: a ProjectReference dependency cannot
         express the EXACT [version] range the forwarding contract promises. No code means no
         symbols either - nuget.org rejects an empty .snupkg outright, which once halted a
         publish part-way (3.2.0 shipped 3 of 9 packages), so IncludeSymbols stays off. -->
    <NuspecFile>LogicalOptimizer.Full.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <IncludeSymbols>false</IncludeSymbols>
    <IsPackable>true</IsPackable>
    <!-- NU5128 is the expected "dependencies but no lib/" warning for a forwarding shell. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Nothing to validate: no assemblies ship. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

</Project>
