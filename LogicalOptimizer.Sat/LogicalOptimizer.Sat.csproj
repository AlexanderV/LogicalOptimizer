<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- v4.0 consolidation: this assembly ships INSIDE the LogicalOptimizer package; the
         old package ID is published as a deprecated forwarding shell from forwarding/. -->
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>

    <!-- Native AOT / trimming contract (roadmap P0.1): the library is reflection-free,
         so these analyzers gate every build (TreatWarningsAsErrors) and prove that the
         public surface stays AOT- and trim-safe. IsAotCompatible requires net8.0+. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Shared package metadata is centralized in ..\Directory.Build.props. -->
    <PackageId>LogicalOptimizer.Sat</PackageId>
    <Description>SAT layer of the LogicalOptimizer toolkit: dependency-free CDCL solver (incremental, assumptions, unsat cores, DRAT proofs), Tseitin and Plaisted-Greenbaum CNF encodings, cardinality/pseudo-Boolean constraints and weighted MaxSAT.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sat-solver;cdcl;tseitin;drat;maxsat;cardinality;pseudo-boolean;native-aot;pure-managed</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogicalOptimizer" />
    <InternalsVisibleTo Include="LogicalOptimizer.Minimization" />
    <InternalsVisibleTo Include="LogicalOptimizer.Dnnf" />
    <InternalsVisibleTo Include="LogicalOptimizer.Tests" />
    <InternalsVisibleTo Include="LogicalOptimizer.Cli" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <ProjectReference Include="..\LogicalOptimizer.Core\LogicalOptimizer.Core.csproj" />
  </ItemGroup>

</Project>
