<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LogicalOptimizer</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logical-optimizer</ToolCommandName>
    <PackageId>LogicalOptimizer.Cli</PackageId>
    <Version>2.4.0</Version>
    <Authors>Oleksandr Panasenko</Authors>
    <Description>Command-line interface for LogicalOptimizer: boolean expression optimization with provable minimality, truth tables, CSV input, multi-output minimization, and export formats.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>boolean;logic;minimization;cli;quine-mccluskey;sat</PackageTags>
    <PackageProjectUrl>https://AlexanderV.github.io/LogicalOptimizer/</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicalOptimizer\LogicalOptimizer.csproj" />
    <InternalsVisibleTo Include="LogicalOptimizer.Tests" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
