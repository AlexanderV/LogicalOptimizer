<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LogicalOptimizer</RootNamespace>

    <!-- Shared package metadata is centralized in ..\Directory.Build.props. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logical-optimizer</ToolCommandName>
    <PackageId>LogicalOptimizer.Cli</PackageId>
    <Description>Command-line interface for LogicalOptimizer: boolean expression optimization with provable minimality, truth tables, CSV input, multi-output minimization, and export formats.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>boolean;logic;minimization;cli;quine-mccluskey;sat;boolean-expression;expression-simplification;equivalence-checking</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicalOptimizer\LogicalOptimizer.csproj" />
    <!-- Standard-format verbs (solve/maxsat/solve-pb) parse via .Formats; the d-DNNF
         `count` engine lives in .Dnnf, which the facade does not pull in. -->
    <ProjectReference Include="..\LogicalOptimizer.Formats\LogicalOptimizer.Formats.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Dnnf\LogicalOptimizer.Dnnf.csproj" />
    <InternalsVisibleTo Include="LogicalOptimizer.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
