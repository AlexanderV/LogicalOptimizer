# Normalize all text files to LF in the repository; checkout uses native EOL
* text=auto

# Explicit text files
*.cs text
*.csproj text
*.sln text
*.md text
*.json text
*.yml text
*.yaml text

# Windows scripts always CRLF, shell scripts always LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Two trailing spaces are Markdown's hard line break, and the README/docs hero lines rely on it.
# Without this, `git diff --check` reports those lines as trailing-whitespace errors and a real
# whitespace defect elsewhere would be lost in the noise. Trailing whitespace stays an error
# everywhere else, where it is genuinely meaningless.
*.md whitespace=-trailing-space
