<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Samples</RootNamespace>
    <!-- Samples are documentation, never shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Recipes use the public API through project references (a consumer would use the
         published NuGet packages instead). The facade covers Core/Sat/Bdd/Minimization;
         .Dnnf is referenced explicitly because the facade does not pull it in. -->
    <ProjectReference Include="..\..\LogicalOptimizer\LogicalOptimizer.csproj" />
    <ProjectReference Include="..\..\LogicalOptimizer.Dnnf\LogicalOptimizer.Dnnf.csproj" />
  </ItemGroup>

</Project>
