<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- v4.0 consolidation: this assembly ships INSIDE the LogicalOptimizer package; the
         old package ID is published as a deprecated forwarding shell from forwarding/. -->
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>

    <!-- Native AOT / trimming contract (roadmap P0.1): the library is reflection-free,
         so these analyzers gate every build (TreatWarningsAsErrors) and prove that the
         public surface stays AOT- and trim-safe. IsAotCompatible requires net8.0+. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Shared package metadata is centralized in ..\Directory.Build.props. -->
    <PackageId>LogicalOptimizer.Formats</PackageId>
    <Description>Standard-format import/export layer of the LogicalOptimizer toolkit: streaming, budget-aware parsers and round-trip writers for DIMACS CNF, WCNF (weighted partial MaxSAT) and OPB (pseudo-Boolean) problems, each able to hand off directly to the in-house SAT, MaxSAT and pseudo-Boolean engines.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dimacs;wcnf;opb;sat;maxsat;pseudo-boolean;native-aot;pure-managed</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogicalOptimizer.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <ProjectReference Include="..\LogicalOptimizer.Core\LogicalOptimizer.Core.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Sat\LogicalOptimizer.Sat.csproj" />
  </ItemGroup>

</Project>
