{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "LogicalOptimizer.Core/LogicalOptimizer.Core.csproj",
            "LogicalOptimizer.Sat/LogicalOptimizer.Sat.csproj",
            "LogicalOptimizer.Bdd/LogicalOptimizer.Bdd.csproj",
            "LogicalOptimizer.Minimization/LogicalOptimizer.Minimization.csproj",
            "LogicalOptimizer/LogicalOptimizer.csproj"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "filter": "filterConfig.yml",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      },
      {
        "files": [ "schema/**/*.json" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "LogicalOptimizer",
      "_appTitle": "LogicalOptimizer Documentation",
      "_description": "Dependency-free .NET Boolean expression toolkit: provable minimization, CDCL SAT, ROBDD, and CNF/DNF export.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/AlexanderV/LogicalOptimizer",
        "branch": "main"
      },
      "_appFooter": "LogicalOptimizer &mdash; dependency-free .NET Boolean toolkit. Apache-2.0."
    },
    "sitemap": {
      "baseUrl": "https://AlexanderV.github.io/LogicalOptimizer/"
    }
  }
}
