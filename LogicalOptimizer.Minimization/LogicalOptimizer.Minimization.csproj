<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>

    <!-- Native AOT / trimming contract (roadmap P0.1): the library is reflection-free,
         so these analyzers gate every build (TreatWarningsAsErrors) and prove that the
         public surface stays AOT- and trim-safe. IsAotCompatible requires net8.0+. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <PackageId>LogicalOptimizer.Minimization</PackageId>
    <Version>3.0.0</Version>
    <Authors>Oleksandr Panasenko</Authors>
    <Description>Minimization layer of the LogicalOptimizer toolkit: exact Quine-McCluskey with provable-minimality status, SAT-based mid-range prime covers, Espresso-style cube-list heuristics, multi-output PLA-style cube sharing and CSV truth-table parsing.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>quine-mccluskey;minimization;espresso;two-level;multi-output;pla</PackageTags>
    <PackageProjectUrl>https://AlexanderV.github.io/LogicalOptimizer/</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogicalOptimizer" />
    <InternalsVisibleTo Include="LogicalOptimizer.Tests" />
    <InternalsVisibleTo Include="LogicalOptimizer.Cli" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <ProjectReference Include="..\LogicalOptimizer.Core\LogicalOptimizer.Core.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Sat\LogicalOptimizer.Sat.csproj" />
  </ItemGroup>

</Project>
