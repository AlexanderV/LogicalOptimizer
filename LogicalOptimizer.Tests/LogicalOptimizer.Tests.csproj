<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.8.0" />
    <!-- Draft 2020-12 validator used by CliReportSchemaTests to check the published CLI JSON
         Schema against real reports. TEST-ONLY: the shipped packages stay free of third-party
         runtime dependencies. -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.2" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicalOptimizer\LogicalOptimizer.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Core\LogicalOptimizer.Core.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Sat\LogicalOptimizer.Sat.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Bdd\LogicalOptimizer.Bdd.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Dnnf\LogicalOptimizer.Dnnf.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Formats\LogicalOptimizer.Formats.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Minimization\LogicalOptimizer.Minimization.csproj" />
    <ProjectReference Include="..\LogicalOptimizer.Cli\LogicalOptimizer.Cli.csproj" />
    <!-- Benchmarks harnesses under test (CancellationOvershootHarnessTests). NOT part of the
         pinned public API surface — the Benchmarks project is a dev tool, never packaged. -->
    <ProjectReference Include="..\LogicalOptimizer.Benchmarks\LogicalOptimizer.Benchmarks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runner diagnostics: any test running past longRunningTestSeconds is named in the
         console (visible at console verbosity "normal"+), so a CPU-bound exhaustive sweep
         reads as progress, not as a hang. tools/test.ps1 relies on this. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The published CLI JSON Schema and its golden example reports, copied to the test output
         so CliReportSchemaTests can load them independently of the working directory. -->
    <None Include="..\schema\**" Link="Schema\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Vendored SATLIB-style SAT corpus (see SatCorpusRegressionTests); copied to the test
         output so the corpus regression suite can load it independently of the working dir. -->
    <None Include="..\LogicalOptimizer.Benchmarks\SatCorpus\*.cnf"
          Link="SatCorpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Vendored multi-output PLA corpus and adversarial BDD variable-order corpus
         (PlaCorpusRegressionTests / BddOrderCorpusRegressionTests); same copy pattern. -->
    <None Include="..\LogicalOptimizer.Benchmarks\PlaCorpus\*.pla"
          Link="PlaCorpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LogicalOptimizer.Benchmarks\BddOrderCorpus\*.expr"
          Link="BddOrderCorpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>