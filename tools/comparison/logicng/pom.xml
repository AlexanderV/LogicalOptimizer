<?xml version="1.0" encoding="UTF-8"?>
<!--
  Roadmap P0.2 — LogicNG BDD competitor adapter for the cross-library comparison.

  LogicNG is a JVM library, so its adapter is a small self-contained Java program
  (unlike the shell adapters for CaDiCaL/Kissat/d4). The shade plugin bundles LogicNG
  and its transitive dependencies (ANTLR runtime) into one executable jar so the
  container can run it with a bare `java -jar`. It reads the SAME committed corpus the
  OUR-side harness consumes and prints a Markdown column of BDD node count + exact
  model count, keyed by function name, applying the shared per-function timeout.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.logicng.comparison</groupId>
    <artifactId>logicng-adapter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pinned so the comparison is reproducible; matches the version documented
             in tools/comparison/README.md. -->
        <logicng.version>2.4.1</logicng.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.logicng</groupId>
            <artifactId>logicng</artifactId>
            <version>${logicng.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>logicng-adapter</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.logicng.comparison.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
